# Example environment variables for hrms_database container (no secrets)
# Configure these via orchestrator; do not commit real .env files.

# Preferred: DATABASE_URL recognized if it starts with sqlite://
# Example absolute path: sqlite:////app/myapp.db
# DATABASE_URL=sqlite:////app/myapp.db

# Or direct file path
# SQLITE_DB_PATH=/app/myapp.db

# Alternative aliases
# BACKEND_SQLITE_DB_PATH=/app/myapp.db
# REACT_APP_SQLITE_DB_PATH=/app/myapp.db

# Health server port (default 5001)
HEALTH_SERVER_PORT=5001
