# Example environment variables for hrms_database (do not commit real secrets)
# Prefer DATABASE_URL when using sqlite:// style, otherwise use SQLITE_DB_PATH.
# Precedence (effective path resolution):
# 1) DATABASE_URL (only if it starts with sqlite://)
# 2) SQLITE_DB_PATH
# 3) BACKEND_SQLITE_DB_PATH
# 4) REACT_APP_SQLITE_DB_PATH
# 5) default: myapp.db (inside container working directory)

# Example absolute path via DATABASE_URL (note 4 leading slashes for absolute path)
# DATABASE_URL=sqlite:////home/kavia/workspace/code-generation/unified-hr-management-system-5562-5727/hrms_database/myapp.db

# Example direct path
# SQLITE_DB_PATH=/home/kavia/workspace/code-generation/unified-hr-management-system-5562-5727/hrms_database/myapp.db

# Optional alternative variables (aliases)
# BACKEND_SQLITE_DB_PATH=/path/to/myapp.db
# REACT_APP_SQLITE_DB_PATH=/path/to/myapp.db

# Health server port (defaults to 5001)
# HEALTH_SERVER_PORT=5001
