# Example environment variables for hrms_database container
# Copy to your orchestrator environment management; do not commit real secrets.

# PUBLIC_INTERFACE
# HEALTH_SERVER_PORT controls the FastAPI health server port (default 5001).
HEALTH_SERVER_PORT=5001

# PUBLIC_INTERFACE
# Preferred SQLite path as a DATABASE_URL when using SQLite (must start with sqlite://)
# Example absolute path: sqlite:////app/myapp.db
# Example relative path: sqlite:///myapp.db
# DATABASE_URL=

# PUBLIC_INTERFACE
# Alternative direct SQLite DB path vars (precedence after DATABASE_URL)
# SQLITE_DB_PATH=/app/myapp.db
# BACKEND_SQLITE_DB_PATH=/app/myapp.db
# REACT_APP_SQLITE_DB_PATH=/app/myapp.db
