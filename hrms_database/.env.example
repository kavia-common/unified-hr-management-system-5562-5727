# Example environment variables for hrms_database container
# Copy to your orchestrator-managed .env and adjust as needed.
#
# Preferred: use DATABASE_URL with sqlite file scheme:
#   sqlite:////absolute/path/to/myapp.db  (note 4 slashes for absolute)
# The service will also accept SQLITE_DB_PATH as an alias to point directly to a file.
#
# Only one of DATABASE_URL or SQLITE_DB_PATH is needed. BACKEND_SQLITE_DB_PATH and
# REACT_APP_SQLITE_DB_PATH remain supported as fallbacks.

# sqlite URL (preferred)
# DATABASE_URL=sqlite:////app/myapp.db

# direct file path (common alias)
# SQLITE_DB_PATH=/app/myapp.db

# backend-specific path (fallback)
# BACKEND_SQLITE_DB_PATH=/app/myapp.db

# legacy frontend var (last resort fallback)
# REACT_APP_SQLITE_DB_PATH=/app/myapp.db

# health server port (defaults to 5001)
# HEALTH_SERVER_PORT=5001
