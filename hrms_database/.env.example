# Example environment variables for hrms_database container

# Absolute path to the SQLite database file used by backend and readiness service.
REACT_APP_SQLITE_DB_PATH=/absolute/path/to/myapp.db

# Optional: alternative source; if provided and parseable it will be used.
# REACT_APP_DATABASE_URL=sqlite:////absolute/path/to/myapp.db
# DATABASE_URL=sqlite:////absolute/path/to/myapp.db

# Port on which the readiness service listens. Defaults to 5001 if not set.
PORT=5001
