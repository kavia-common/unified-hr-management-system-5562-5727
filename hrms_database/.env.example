# Example environment variables for hrms_database container

# Preferred: backend-style database URL (SQLite)
# Use absolute path for portability in containers.
# Example: sqlite:////app/myapp.db
DATABASE_URL=sqlite:////app/myapp.db

# Alternatively, you can specify a direct file path for the backend to use.
# BACKEND_SQLITE_DB_PATH=/app/myapp.db

# Legacy fallback (frontend-scoped); not recommended for backend services.
# REACT_APP_SQLITE_DB_PATH=/app/myapp.db

# Health server port (default 5001)
HEALTH_SERVER_PORT=5001
