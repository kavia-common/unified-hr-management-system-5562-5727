# HRMS Database (.env example)
# Do not commit real secrets. Copy this file to .env and customize per environment.

# Preferred way to point to SQLite file (only sqlite:// is supported here)
# Examples:
# - sqlite:////app/myapp.db     (absolute path)
# - sqlite:///myapp.db          (relative path to working directory)
DATABASE_URL=

# Direct path alias to SQLite file (used if DATABASE_URL is not provided or not sqlite://)
# Example: /app/myapp.db
SQLITE_DB_PATH=

# Alternate backend variable name (used if above are not provided)
BACKEND_SQLITE_DB_PATH=

# Legacy/fallback (front-end styled var name; not recommended for backend)
REACT_APP_SQLITE_DB_PATH=

# Port for FastAPI health server; defaults to 5001 if unset or invalid
HEALTH_SERVER_PORT=5001
